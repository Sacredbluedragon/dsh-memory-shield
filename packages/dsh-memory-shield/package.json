{
  "name": "dsh-memory-shield",
  "version": "0.1.13",
  "description": "记忆遮蔽插件：在指定 DSH preset 内遮蔽其他记忆插件注入的上下文与工具，让该会话拿到干净上下文。默认关闭，需在目标 preset 里挂载并设置 enabled: true 才生效。",
  "type": "module",
  "main": "./index.js",
  "license": "MIT",
  "author": "Sacredbluedragon",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "shadow",
    "shim"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sacredbluedragon/dsh-memory-shield.git"
  },
  "bugs": {
    "url": "https://github.com/Sacredbluedragon/dsh-memory-shield/issues"
  },
  "homepage": "https://github.com/Sacredbluedragon/dsh-memory-shield#readme",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "@deepseek-ai/dsh-scope": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-scope": {
      "optional": true
    }
  }
}
