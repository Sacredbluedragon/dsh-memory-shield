{
  "name": "dsh-memory-core",
  "version": "0.1.0",
  "private": true,
  "description": "遮蔽会话的 companion 记忆包：给 dsh-memory-shield (shield) 遮蔽过的会话加一套隔离的记忆存储（独立数据目录，与 dsh-memory-evolve 完全隔离）。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./manage.html": "./manage.html",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  }
}
