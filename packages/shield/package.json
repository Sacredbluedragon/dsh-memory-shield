{
  "name": "dsh-memory-shield",
  "version": "0.1.4",
  "description": "Universal memory shadow plugin for DSH: shadows other memory plugins' context and tools within a preset, giving that channel a clean context.",
  "type": "module",
  "main": "./index.js",
  "license": "MIT",
  "author": "Sacredbluedragon",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "preset",
    "memory",
    "shadow",
    "shim"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sacredbluedragon/dsh-memory-shield.git"
  },
  "bugs": {
    "url": "https://github.com/Sacredbluedragon/dsh-memory-shield/issues"
  },
  "homepage": "https://github.com/Sacredbluedragon/dsh-memory-shield#readme",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  }
}
