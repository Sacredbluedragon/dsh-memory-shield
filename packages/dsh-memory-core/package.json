{
  "name": "dsh-memory-core",
  "version": "0.1.9",
  "description": "被 dsh-memory-shield 遮蔽的会话的隔离记忆包：五轨（memory/user/project/key/daily）独立数据目录，与 dsh-memory-evolve 完全隔离。装完即已生效——默认只提供管理页，不接管任何会话；在目标 preset 里设 memoryEnabled: true 才启用。",
  "type": "module",
  "main": "./index.js",
  "license": "MIT",
  "author": "Sacredbluedragon",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "preset",
    "memory",
    "memory-core",
    "isolated"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sacredbluedragon/dsh-memory-shield.git",
    "directory": "packages/dsh-memory-core"
  },
  "bugs": {
    "url": "https://github.com/Sacredbluedragon/dsh-memory-shield/issues"
  },
  "homepage": "https://github.com/Sacredbluedragon/dsh-memory-shield/tree/main/packages/dsh-memory-core#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./manage.html": "./manage.html",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "manage.html",
    "lib/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  }
}
